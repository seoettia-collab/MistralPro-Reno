# Scope security and freshness to the standalone quote page and its assets.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header unset Cache-Control
  Header always set Cache-Control "no-store"
  <FilesMatch "\.(css|js|woff2)$">
    Header onsuccess unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "no-store"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://bzrcdn.openai.com; style-src 'self'; connect-src 'self' https://facebook-ads-backend-s20a.onrender.com https://bzr.openai.com https://bzrcdn.openai.com; img-src 'self' https://bzr.openai.com; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>

