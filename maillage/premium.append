
/* MAILLAGE-BOUTIQUE : fil d'Ariane, liens et bloc boutique */
nav.mpr-breadcrumb { margin: 0 0 18px; padding: 0; background: transparent; font-size: 12px; line-height: 1.6; color: inherit; }
.mpr-breadcrumb ol { display: flex; flex-wrap: wrap; align-items: center; margin: 0; padding: 0; list-style: none; }
.mpr-breadcrumb li { display: inline-flex; align-items: center; margin: 0; }
.mpr-breadcrumb li + li::before { content: "›"; margin: 0 .6em; opacity: .6; }
.mpr-breadcrumb a { display: inline-flex; align-items: center; min-height: 32px; color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.mpr-breadcrumb [aria-current="page"] { opacity: .75; }
nav.mpr-breadcrumb--light { color: #fff; }
.text-center .mpr-breadcrumb ol { justify-content: center; }
main > nav.mpr-breadcrumb.premium-container { margin: 0 auto; padding: 16px clamp(22px, 4.7vw, 72px) 4px; }
.premium-site .mpr-shop-links { margin: 40px 0; padding: 28px; border: 1px solid var(--premium-rule); border-radius: 3px; background: var(--premium-paper); }
.premium-site .mpr-shop-links h2,
.premium-site .article-content .mpr-shop-links h2 { margin: 0 0 8px; font-size: 22px; line-height: 1.3; }
.premium-site .mpr-shop-links p { margin: 0; color: var(--premium-muted); font-size: 14px; line-height: 1.7; }
.premium-site .mpr-shop-links__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.premium-site .mpr-shop-links .btn,
.premium-site .article-content .mpr-shop-links a.btn { min-height: 44px; padding: 11px 18px; border: 1px solid #c5c0b7; border-radius: 4px; background: transparent; box-shadow: none; color: var(--premium-ink); font-size: 13px; font-weight: 700; text-decoration: none; }
.premium-site .mpr-shop-links .btn:hover { border-color: var(--premium-ink); transform: none; }
