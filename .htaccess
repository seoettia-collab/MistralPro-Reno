# =========================================
# CANONICAL URLS - HTTPS, www and directory index
# =========================================
RewriteEngine On
# Only redirect explicit index.html requests, never Apache's internal index lookup.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ https://www.mistralpro-reno.fr/$1 [L,R=301]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.mistralpro-reno\.fr$ [NC]
RewriteRule ^ https://www.mistralpro-reno.fr%{REQUEST_URI} [L,R=301,NE]

# Browsers also request the conventional root icon when no page icon is cached.
RedirectMatch 301 ^/favicon\.ico$ /images/favicon.ico

# =========================================
# REDIRECTIONS 301 - Ancien simulateur et alias publics
# =========================================
# mod_alias preserves the original query string when the target has no query.
# Keep this rule only after /estimation-projet.html readiness is verified.
# Retired portfolio: keep previously shared URLs useful.
Redirect 301 /projets.html /travaux.html
Redirect 301 /blog/cout-renovation-appartement-paris.html /blog/prix-renovation-appartement-paris-2026.html
Redirect 301 /blog/renovation-salle-de-bain-guide-prix.html /blog/prix-renovation-salle-de-bain-paris-2026.html
Redirect 301 /blog/prix-renovation-de-habitation-ile-de-france.html /blog/renovation-maison-ile-de-france-2026.html
# Alias de la refonte déjà publiée : conserver les URL services historiques.
Redirect 301 /metiers.html /services.html
Redirect 301 /metiers/maconnerie.html /services/maconnerie.html
Redirect 301 /metiers/couverture.html /services/toiture.html
Redirect 301 /metiers/isolation.html /services/isolation.html
Redirect 301 /metiers/plomberie.html /services/plomberie.html
Redirect 301 /metiers/electricite.html /services/electricite.html
Redirect 301 /metiers/platrerie.html /services/platrerie.html
Redirect 301 /metiers/peinture.html /services/peinture.html
Redirect 301 /metiers/carrelage.html /services/carrelage.html
Redirect 301 /metiers/menuiserie.html /services/menuiserie.html
Redirect 301 /cost_calculator.html /estimation-projet.html
Redirect 301 /landing.html /estimation-projet.html
Redirect 301 /contact.html /estimation-projet.html
Redirect 301 /landing /estimation-projet.html
Redirect 301 /contact /estimation-projet.html
Redirect 301 /devis /estimation-projet.html

# =========================================
# CACHE OPTIMIZATION - Mistral Pro Reno
# =========================================

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Cache Control - 1 YEAR for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default
  ExpiresDefault "access plus 1 month"
  
  # CSS - 1 year
  ExpiresByType text/css "access plus 1 year"
  
  # JavaScript - 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Images - 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts - 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML - no cache (always fresh)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # CSS, JS, Fonts, Images - 1 year immutable
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot|ico|jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML - no cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# SEO: do not index the publishing template itself.
<IfModule mod_headers.c>
  <Files "TEMPLATE.html">
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

# Preserve an HTTP 404 while displaying the existing helpful error page.
ErrorDocument 404 /404.html
